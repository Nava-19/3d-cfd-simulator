FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

vertices
(
    ({{ x_inlet }}   0.0          0.0)           // 0: Eje aguas arriba
    ( 0.0            0.0          0.0)           // 1: Vértice del cono (0,0,0)
    ({{ x_outlet }}  {{ y_cone }} -{{ z_cone }}) // 2: Base del cono (plano trasero)
    ({{ x_inlet }}   {{ y_top }}  -{{ z_top }})  // 3: Techo entrada (plano trasero)
    ( 0.0            {{ y_top }}  -{{ z_top }})  // 4: Techo medio (plano trasero)
    ({{ x_outlet }}  {{ y_top }}  -{{ z_top }})  // 5: Techo salida (plano trasero)

    ({{ x_outlet }}  {{ y_cone }}  {{ z_cone }}) // 6: Base del cono (plano delantero)
    ({{ x_inlet }}   {{ y_top }}   {{ z_top }})  // 7: Techo entrada (plano delantero)
    ( 0.0            {{ y_top }}   {{ z_top }})  // 8: Techo medio (plano delantero)
    ({{ x_outlet }}  {{ y_top }}   {{ z_top }})  // 9: Techo salida (plano delantero)
);

blocks
(
    hex (0 1 4 3 0 1 8 7) ({{ nx_up }} {{ ny }} 1) simpleGrading (1 1 1)
    hex (1 2 5 4 1 6 9 8) ({{ nx_cone }} {{ ny }} 1) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    inlet
    {
        type            patch;
        faces
        (
            (0 0 7 3)
        );
    }

    outlet
    {
        type            patch;
        faces
        (
            (2 5 9 6)
        );
    }

    farfield
    {
        type            patch;
        faces
        (
            (3 7 8 4)
            (4 8 9 5)
        );
    }

    cone
    {
        type            wall;
        faces
        (
            (1 2 6 1)
        );
    }

    axis
    {
        type            empty;
        faces
        (
            (0 1 1 0)
        );
    }

    wedge_back
    {
        type            wedge;
        faces
        (
            (0 3 4 1)
            (1 4 5 2)
        );
    }

    wedge_front
    {
        type            wedge;
        faces
        (
            (0 1 8 7)
            (1 6 9 8)
        );
    }
);

mergePatchPairs
(
);

