FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform {{ k_inf }};

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform {{ k_inf }};
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform {{ k_inf }};
        value           uniform {{ k_inf }};
    }

    farfield
    {
        type            fixedValue;
        value           uniform {{ k_inf }};
    }

    symmetry
    {
        type            symmetryPlane;
    }

    {% for patch in rocket_patches %}
    {{ patch }}
    {
        type            kqRWallFunction;
        value           uniform 1e-10;
    }
    {% endfor %}
}

// ************************************************************************* //
